# 이 파일을 복사해 secrets.toml 로 이름을 바꾸고 키를 넣으세요. secrets.toml 은 GitHub에 올라가지 않습니다.
# 배포 시에는 Streamlit Cloud > Manage app > Settings > Secrets 에 같은 내용을 붙여 넣습니다.
# 키가 비어 있는 항목은 자동으로 '시연 모드'로 동작합니다.

CAREERNET_API_KEY = ""   # 커리어넷 Open API 인증키
KOSIS_API_KEY = ""       # KOSIS 공유서비스 인증키
WORK24_JOB_KEY = ""      # 고용24 OPEN-API "직업정보" 서비스 인증키 (서비스마다 키가 다름)
WORK24_TRAINING_KEY = ""  # 고용24 "국민내일배움카드 훈련과정" 서비스 인증키 (선택한 직무 관련 국비 교육과정 추천)
# WORKNET_API_KEY = ""   # 예전 이름. WORK24_JOB_KEY가 없으면 이 값을 씁니다
QNET_API_KEY = ""        # 공공데이터포털 한국산업인력공단 국가자격 공개문제 조회 서비스 인증키(개발계정)

LLM_PROVIDER = "openai"  # openai(기본) | anthropic
LLM_MODEL = "gpt-5-mini" # OpenAI 요금표(openai.com/api/pricing)에서 확인 후 바꿔도 됩니다
ANSWER_MODE = "balanced"  # balanced(공공데이터+AI 지식) | strict(근거 우선)
# LLM_TEMPERATURE = "0.6"  # gpt-4o 계열에서만 사용 (선택)
OPENAI_API_KEY = ""      # 팀 공용 키
LLM_SESSION_LIMIT = "20" # 팀 키로 한 접속당 물어볼 수 있는 질문 수
